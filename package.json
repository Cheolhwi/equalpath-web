    "test:browser": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.183.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
