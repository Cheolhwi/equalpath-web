{
  "name": "equalpath-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:enquiry": "node experiments/virtual-enquiry/start.mjs",
    "enquiry:setup": "node experiments/virtual-enquiry/setup.mjs",
    "snapshot:refresh": "node scripts/build-catalog-snapshot.mjs --live",
    "dev": "vite --host 127.0.0.1 --port 4179",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4179",
    "test": "node --test tests/*.test.mjs",
    "release": "npm test && node scripts/deploy-api.mjs && node scripts/package-enquiry.mjs && npm run build && node scripts/check-build.mjs",
    "test:browser": "playwright test",
    "local:setup": "python3 database/postgres/scripts/local.py start && python3 database/postgres/scripts/load.py",
    "local:start": "python3 database/postgres/scripts/local.py start && python3 database/postgres/scripts/local.py app",
    "local:stop": "python3 database/postgres/scripts/local.py stop",
    "local:verify": "python3 database/postgres/scripts/verify.py",
    "local:test": "npm run local:verify && python3 database/postgres/scripts/local.py test"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.183.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
