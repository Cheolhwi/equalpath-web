{
  "name": "equalpath-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot:refresh": "node scripts/build-catalog-snapshot.mjs --live",
    "dev": "vite --host 127.0.0.1 --port 4179",
